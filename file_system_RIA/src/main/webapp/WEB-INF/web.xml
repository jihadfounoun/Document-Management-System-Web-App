<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" version="4.0">
  <display-name>ProjectRIA</display-name>
  <welcome-file-list>
    <welcome-file>login.html</welcome-file>
  </welcome-file-list>
  <context-param>
	<param-name>driverDB</param-name>
	<param-value>com.mysql.cj.jdbc.Driver</param-value>
  </context-param>
  <context-param>
	<param-name>urlDB</param-name>
	<param-value>jdbc:mysql://localhost:3306/document_management_system</param-value>
  </context-param>
  <context-param>
	<param-name>userDB</param-name>
	<param-value>root</param-value>
  </context-param>
    <context-param>
	<param-name>pwdDB</param-name>
	<param-value>brodi</param-value>
  </context-param>
    <filter>
	<filter-name>CacheReset</filter-name>
	<filter-class>filters.CacheReset</filter-class>
  </filter>
  <filter>
	<filter-name>AuthFilter</filter-name>
  	<filter-class>filters.AuthFilter</filter-class>
  </filter>
    <filter>
	<filter-name>NoAuthFilter</filter-name>
	<filter-class>filters.NoAuthFilter</filter-class>
  </filter>
    <filter-mapping>
	<filter-name>CacheReset</filter-name>
  <url-pattern>/home.html</url-pattern>
  <url-pattern>/login.html</url-pattern>
  </filter-mapping>
  <filter-mapping>
	<filter-name>AuthFilter</filter-name>
	<url-pattern>/home.html</url-pattern>
	<url-pattern>/DeleteFolder</url-pattern>
	<url-pattern>/DeleteDocument</url-pattern>
	<url-pattern>/GetItems</url-pattern>
  	<url-pattern>/MoveDocument</url-pattern>
  	<url-pattern>/AddDocument</url-pattern>
  	<url-pattern>/AddFolder</url-pattern>
  	<url-pattern>/Logout</url-pattern>
  </filter-mapping>
    <filter-mapping>
	<filter-name>NoAuthFilter</filter-name>
	<url-pattern>/login.html</url-pattern>
	<url-pattern>/Register</url-pattern>
	<url-pattern>/Login</url-pattern>
  </filter-mapping>

</web-app>